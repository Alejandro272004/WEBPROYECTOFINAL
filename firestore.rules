rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para usuarios: Cualquiera autenticado puede leer, solo el dueño puede escribir
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para movimientos: El usuario puede ver sus propios movimientos
    match /movimientos/{movId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Reglas para huchas: Solo el dueño puede ver y gestionar sus huchas
    match /huchas/{huchaId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}